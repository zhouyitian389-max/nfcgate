<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YitianNFC" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/gold_bright</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>

    <style name="Theme.YitianNFC.Splash" parent="Theme.YitianNFC">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="ButtonStyle.Gold" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_gold_gradient</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="ButtonStyle.OutlineGold" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/gold</item>
        <item name="strokeColor">@color/gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
