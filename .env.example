# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=******localhost:5432/nfcgate?schema=public
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters each
JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-refresh-secret
# Access token lifetime (e.g. 15m, 1h). Invalid values fall back to 15m.
JWT_EXPIRES_IN=15m
# Refresh token lifetime (e.g. 7d, 168h)
JWT_REFRESH_EXPIRES_IN=7d
# Max failed logins per window before account lock
AUTH_RATE_LIMIT_MAX=30

# ─── Card Encryption ─────────────────────────────────────────────────────────
# REQUIRED in production: exactly 64 hex characters (256-bit AES key)
# Generate with: openssl rand -hex 32
CARD_ENCRYPTION_KEY=replace-with-64-char-hex-string

# ─── Relay ───────────────────────────────────────────────────────────────────
RELAY_TOKEN_TTL_MINUTES=30
RELAY_SESSION_TIMEOUT_MS=20000
RELAY_HEARTBEAT_MS=10000

# ─── Server / Network ────────────────────────────────────────────────────────
PORT=8080
SERVER_PORT=8080
WS_PORT=8080
ADMIN_PORT=3001
# Number of trusted reverse-proxy hops (for req.ip to reflect real client IP)
TRUST_PROXY_HOPS=1

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty or set to '*' with caution.
CORS_ORIGIN=https://your-admin-panel-domain.example.com

# ─── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production

# ─── Frontend (admin-panel, NEXT_PUBLIC_* variables) ─────────────────────────
NEXT_PUBLIC_API_BASE=https://your-backend-domain.example.com/api
