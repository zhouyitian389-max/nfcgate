<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ── YitianNFC 连接设置 ─────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/settings_category_yitian">

        <ListPreference
            android:key="upload_mode"
            android:title="@string/settings_upload_mode"
            android:entries="@array/settings_upload_mode_entries"
            android:entryValues="@array/settings_upload_mode_values"
            android:defaultValue="cloud" />

        <EditTextPreference
            android:key="api_server_url"
            android:title="@string/settings_api_server"
            android:defaultValue="https://api.yitian.shop"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="cloud_api_base"
            android:title="@string/settings_cloud_base"
            android:defaultValue="https://api.yitian.shop"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="cloud_email"
            android:title="@string/settings_cloud_email"
            android:defaultValue=""
            android:inputType="textEmailAddress"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="yitian_host"
            android:title="@string/settings_yitian_nfc_host"
            android:summary="@string/settings_yitian_nfc_host_summary"
            android:defaultValue="192.168.1.100"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="yitian_port"
            android:title="@string/settings_yitian_nfc_port"
            android:summary="@string/settings_yitian_nfc_port_summary"
            android:defaultValue="8080"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <!-- ── 扫描设置 ───────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/settings_category_scan">

        <SwitchPreferenceCompat
            android:key="auto_scan"
            android:title="@string/settings_auto_scan"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="auto_sync"
            android:title="@string/settings_auto_sync"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_usb_reader_enabled"
            android:title="@string/settings_usb_reader_mode"
            android:summary="@string/settings_usb_reader_mode_summary"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="scan_timeout"
            android:title="@string/settings_scan_timeout"
            android:defaultValue="15"
            android:max="60"
            app:min="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

    </PreferenceCategory>

    <!-- ── 外观设置 ───────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/settings_category_appearance">

        <ListPreference
            android:key="theme"
            android:title="@string/settings_theme"
            android:entries="@array/settings_theme_entries"
            android:entryValues="@array/settings_theme_values"
            android:defaultValue="dark" />

        <ListPreference
            android:key="language"
            android:title="@string/settings_language"
            android:entries="@array/settings_language_entries"
            android:entryValues="@array/settings_language_values"
            android:defaultValue="system" />

        <SwitchPreferenceCompat
            android:key="haptic_feedback"
            android:title="@string/settings_haptic_feedback"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- ── 旧版中继 URL（保留兼容）────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/settings_category_legacy">

        <EditTextPreference
            android:key="server_url"
            android:title="@string/settings_server_url"
            android:defaultValue="https://relay.example.com/api/upload"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_account">
        <Preference
            android:key="logout"
            android:title="@string/settings_logout" />
    </PreferenceCategory>

</PreferenceScreen>
